# 复制为 .env 后填写。所有字段可被前端 X-LLM-Config header 覆盖（仅本次请求）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# DSH 配置
DSH_HOME=server/.dsh-home
DSH_MODE=standard  # standard | ptc | minimal
# 后端模式开关：true 时尝试启动 DSH；失败则回退到 built-in agent loop
DSH_ENABLED=true

# 可选天气 API（默认 Open-Meteo 免费）
WEATHER_API=open-meteo  # open-meteo | qweather
QWEATHER_KEY=

# 监测频率（秒）
MONITOR_INTERVAL_SEC=3600
MONITOR_PRE_TRIP_INTERVAL_SEC=1800

# CORS（前端静态服务地址）
FRONTEND_ORIGIN=http://localhost:5173
